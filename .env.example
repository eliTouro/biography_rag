# Copy to .env (never commit .env).
# Neon Postgres with pgvector. Leave empty to use an in-memory PGlite database (tests, mock mode).
DATABASE_URL=
OPENAI_API_KEY=
# openai | mock (mock = free, deterministic fake embeddings and answers for tests)
LLM_PROVIDER=openai
CHAT_MODEL=gpt-5.4-mini
EMBED_MODEL=text-embedding-3-small
# Hard stop for API spend per UTC day (USD, estimated from token usage)
DAILY_BUDGET_USD=3
